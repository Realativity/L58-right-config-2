/*
 * Lily58 - right half used standalone (one-handed layout)
 * Hold the Space thumb key to mirror the left half onto the right.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE   0
#define MIRROR 1
#define RAISE  2
#define SYS    3

// Holding Space while typing another key counts as "hold" (mirror layer),
// so fast one-handed typing doesn't spit out stray spaces.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// Right half only (left-half positions are &none):
// |  6  |  7  |  8  |  9  |  0  | BSPC |
// |  Y  |  U  |  I  |  O  |  P  |  -   |
// |  H  |  J  |  K  |  L  |  ;  |  '   |
// [ALT] |  N  |  M  |  ,  |  .  |  /  | SHIFT |
// | SPC/MIRROR | ENTER | RAISE | CTRL |
            display-name = "Base";
            bindings = <
&none &none &none &none &none &none                    &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp BSPC
&none &none &none &none &none &none                    &kp Y  &kp U  &kp I     &kp O   &kp P    &kp MINUS
&none &none &none &none &none &none                    &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&none &none &none &none &none &none &none   &kp LALT   &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                  &none &none &none &none   &lt MIRROR SPACE  &kp RET  &mo RAISE  &kp LCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mirror_layer {
// Hold Space: left half mirrored onto the right
// |  5  |  4  |  3  |  2  |  1  | ESC  |
// |  T  |  R  |  E  |  W  |  Q  | TAB  |
// |  G  |  F  |  D  |  S  |  A  | CTRL |
// [GUI] |  B  |  V  |  C  |  X  |  Z  | SHIFT |
            display-name = "Mirror";
            bindings = <
&none &none &none &none &none &none                    &kp N5 &kp N4 &kp N3 &kp N2 &kp N1 &kp ESC
&none &none &none &none &none &none                    &kp T  &kp R  &kp E  &kp W  &kp Q  &kp TAB
&none &none &none &none &none &none                    &kp G  &kp F  &kp D  &kp S  &kp A  &kp LCTRL
&none &none &none &none &none &none &none   &kp LGUI   &kp B  &kp V  &kp C  &kp X  &kp Z  &kp LSHFT
                  &none &none &none &none   &trans     &trans &trans &trans
            >;
        };

        raise_layer {
// |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |
// |  F7  |  F8  |  F9  |  F10 |  F11 |  F12 |
// | HOME |  <-  |  v   |  ^   |  ->  | END  |
// [DEL]  |  `   |  =   |  [   |  ]   |  \   |      |
// | (hold for SYS) |  |  |  |
            display-name = "Raise";
            bindings = <
&none &none &none &none &none &none                    &kp F1   &kp F2    &kp F3    &kp F4   &kp F5    &kp F6
&none &none &none &none &none &none                    &kp F7   &kp F8    &kp F9    &kp F10  &kp F11   &kp F12
&none &none &none &none &none &none                    &kp HOME &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &kp END
&none &none &none &none &none &none &none   &kp DEL    &kp GRAVE &kp EQUAL &kp LBKT &kp RBKT &kp BSLH  &trans
                  &none &none &none &none   &mo SYS    &trans   &trans    &trans
            >;
        };

        sys_layer {
// Hold Raise, then hold the Space thumb
// | BT1 | BT2 | BT3 | BT4 | BT5 | BT CLEAR |
// | USB | BLE |     |     |     |          |
// |     |     |     |     |     |          |
// [   ] |     |     |     |     |     | BOOTLOADER |
            display-name = "System";
            bindings = <
&none &none &none &none &none &none                    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
&none &none &none &none &none &none                    &out OUT_USB &out OUT_BLE &none        &none        &none        &none
&none &none &none &none &none &none                    &none        &none        &none        &none        &none        &none
&none &none &none &none &none &none &none   &none      &none        &none        &none        &none        &none        &bootloader
                  &none &none &none &none   &trans     &trans       &trans       &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
